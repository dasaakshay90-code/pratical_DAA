#include <bits/stdc++.h>
#include <iostream>
using namespace std;

void primsAlgorithm(int V, vector<vector<pair<int, int>>> &adj) {
    // {weight, vertex}
    priority_queue<pair<int, int>,
                   vector<pair<int, int>>,
                   greater<pair<int, int>>> pq;
const int MAX_VERTICES = 10;
const int INF = 9999;

    vector<bool> visited(V, false);

    // Start from vertex 0
    pq.push({0, 0});

    int totalWeight = 0;

    cout << "Edges in Minimum Spanning Tree:\n";
int main() {
    int n;

    while (!pq.empty()) {
        auto [weight, u] = pq.top();
        pq.pop();
    cout << "Enter number of vertices: ";
    cin >> n;

        if (visited[u])
            continue;
    if (n <= 0 || n > MAX_VERTICES) {
        cout << "Invalid number of vertices. Please enter a value between 1 and 10.\n";
        return 1;
    }

        visited[u] = true;
        totalWeight += weight;
    int graph[MAX_VERTICES][MAX_VERTICES];
    for (int i = 0; i < MAX_VERTICES; ++i) {
        for (int j = 0; j < MAX_VERTICES; ++j) {
            graph[i][j] = INF;
        }
    }

        if (weight != 0) {
            cout << u << " - " << weight << "\n";
    for (int i = 0; i < n; ++i) {
        for (int j = 0; j < n; ++j) {
            graph[i][j] = INF;
            if (i == j) {
                graph[i][j] = 0;
            }
        }
    }

        // Visit all adjacent vertices
        for (auto [v, w] : adj[u]) {
            if (!visited[v]) {
                pq.push({w, v});
    cout << "Enter adjacency matrix (0 means no connection):\n";
    for (int i = 0; i < n; ++i) {
        for (int j = 0; j < n; ++j) {
            cin >> graph[i][j];

            if (i == j) {
                graph[i][j] = 0;
            } else if (graph[i][j] < 0) {
                cout << "Invalid edge weight. Please enter non-negative values.\n";
                return 1;
            } else if (graph[i][j] == 0) {
                graph[i][j] = INF;
            }
        }
    }

    cout << "Total weight = " << totalWeight << endl;
}
    if (n == 1) {
        cout << "\nNo edges needed for a single vertex.\n";
        cout << "Minimum cost = 0\n";
        return 0;
    }

int main() {
    int V, E;
    cin >> V >> E;
    bool selected[MAX_VERTICES] = {false};
    int parent[MAX_VERTICES];
    int key[MAX_VERTICES];

    vector<vector<pair<int, int>>> adj(V);
    for (int i = 0; i < n; ++i) {
        key[i] = INF;
        parent[i] = -1;
    }

    key[0] = 0;
    cout << "\nEdges in Minimum Spanning Tree:\n";

    for (int count = 0; count < n - 1; ++count) {
        int minKey = INF;
        int u = -1;

    // Input: u v weight
    for (int i = 0; i < E; i++) {
        int u, v, w;
        cin >> u >> v >> w;
        for (int i = 0; i < n; ++i) {
            if (!selected[i] && key[i] < minKey) {
                minKey = key[i];
                u = i;
            }
        }

        adj[u].push_back({v, w});
        adj[v].push_back({u, w});
        if (u == -1) {
            cout << "Graph is disconnected. MST cannot be formed.\n";
            return 1;
        }

        selected[u] = true;

        for (int v = 0; v < n; ++v) {
            if (!selected[v] && graph[u][v] != INF && graph[u][v] < key[v]) {
                key[v] = graph[u][v];
                parent[v] = u;
            }
        }
    }

    primsAlgorithm(V, adj);
    int totalCost = 0;
    for (int i = 1; i < n; ++i) {
        cout << parent[i] << " - " << i << " : " << graph[parent[i]][i] << endl;
        totalCost += graph[parent[i]][i];
    }

    cout << "Minimum cost = " << totalCost << endl;
    return 0;
}
